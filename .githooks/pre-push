#!/usr/bin/env bash
# Blocks `git push` from updating develop or master directly. Both branches
# only move via merged PRs, not local pushes -- this hook is that rule
# enforced client-side, before the push even reaches the remote.
#
# Escape hatch for the rare legitimate case (reverting a bad merge, etc.):
#   SKIP_BRANCH_PROTECTION=1 git push

protected_branches="develop master"

if [ -n "$SKIP_BRANCH_PROTECTION" ]; then
    exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    branch="${remote_ref#refs/heads/}"

    for protected in $protected_branches; do
        if [ "$branch" = "$protected" ]; then
            echo "Push rejected: '$protected' only moves via a merged pull request, not a local push." >&2
            echo "If this is intentional, rerun with: SKIP_BRANCH_PROTECTION=1 git push" >&2
            exit 1
        fi
    done
done

exit 0
