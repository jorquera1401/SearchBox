{
    "manifest_version": 3,
    "name": "Tab Wind Command",
    "version": "1.2.0",
    "description": "Fast tab search and AI-powered switching command palette.",
    "permissions": [
        "tabs",
        "scripting",
        "offscreen",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "background": {
        "service_worker": "src/background/index.ts"
    },
    "action": {
        "default_title": "Search Tabs",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content/index.ts"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "ai-bridge.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "commands": {
        "toggle-search": {
            "suggested_key": {
                "default": "Ctrl+Shift+L",
                "mac": "Command+Shift+L"
            },
            "description": "Toggle Tab Search"
        }
    }
}
